# Copy to .env (in backend/) and adjust. Never commit .env.
# Nothing in this file is a secret: v1 has no accounts, no admin token and no API keys.
# The only sensitive value is a PostgreSQL password inside DATABASE_URL, if you use one.

# development | test | production   (APP_ENV is accepted as an alias)
ENVIRONMENT=development

# SQLite file by default, relative to the directory the server is started from.
# PostgreSQL example (needs a driver that is not installed in the project venv):
#   postgresql+psycopg://rtslr:CHANGE_ME@localhost:5432/rtslr
# Production refuses to start while the value still contains CHANGE_ME.
DATABASE_URL=sqlite:///./rtslr.db

# Comma-separated exact origins allowed to call the API from a browser (scheme + host, no path).
# Production refuses to start when this is empty or contains "*".
CORS_ALLOW_ORIGINS=http://localhost:3000

# Feedback write limits per client (POST and DELETE /feedback share them). 0 disables a limit.
RATE_LIMIT_FEEDBACK_PER_MINUTE=10
RATE_LIMIT_FEEDBACK_PER_DAY=100
# Read endpoints, per client per minute. 0 disables it.
RATE_LIMIT_READ_PER_MINUTE=120

# Comma-separated proxy addresses whose X-Forwarded-For header is trusted.
# Empty = use the socket address. Set this when the API runs behind a reverse proxy,
# otherwise every visitor shares the proxy's rate-limit budget.
TRUSTED_PROXY_IPS=

# Create missing tables at startup. Set false when the schema is managed with Alembic.
AUTO_CREATE_TABLES=true
# Load the seed content (models, curriculum, research data) at startup. Idempotent.
SEED_ON_STARTUP=true

# Comma-separated consent text versions accepted by POST /feedback.
CONSENT_VERSIONS=1

# Feedback is deleted this many days after it was created.
FEEDBACK_RETENTION_DAYS=365

# Maximum accepted request body in bytes (larger bodies get 413).
MAX_BODY_BYTES=65536

# Serve /docs, /redoc and /openapi.json in production (always on outside production).
ENABLE_DOCS=false

LOG_LEVEL=info
